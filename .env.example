# Public, non-secret configuration
NEXT_PUBLIC_APP_URL=https://ggaurdai.com
DATABASE_URL=

# Server-only secrets (configure with Vercel CLI/dashboard, never commit values)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# ============================================================================
# Payment Processing (Stripe)
# ============================================================================
# Get keys from: https://dashboard.stripe.com/apikeys
# Test keys: sk_test_... and pk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_BILLING_PORTAL_CONFIGURATION=bpc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_STANDARD=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_EXPRESS=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_COMPREHENSIVE=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_STARTER=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_GROWTH=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ENTERPRISE=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRE_DISPATCH=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRE_DISPATCH_ANNUAL=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_HOA_BASIC=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_HOA_PREMIUM=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_HOA_ENTERPRISE=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PM_STARTER=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PM_PROFESSIONAL=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PM_ENTERPRISE=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# Email (Resend)
# ============================================================================
# Setup guide: See RESEND_SETUP.md
# 1. Create API key: https://resend.com/dashboard/api-keys
# 2. Verify domain: https://resend.com/dashboard/domains
# 3. Add DNS records (SPF, DKIM, MX)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=GGuard Diagnostics <notifications@ggaurdai.com>
ADMIN_NOTIFICATION_EMAIL=cam2verify@gmail.com
PRE_DISPATCH_OPERATIONS_OWNER_EMAIL=clayton@ggaurdai.com
PRE_DISPATCH_SUPPORT_OWNER_EMAIL=clayton@ggaurdai.com

# Error tracking (optional locally, required for production alerts)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ============================================================================
# Cloud Storage (Cloudflare R2)
# ============================================================================
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-west-2
AWS_ROLE_ARN=
S3_BUCKET=

# ============================================================================
# AI Services (Vercel AI Gateway primary; Azure OpenAI backup)
# ============================================================================
# Used for: Invoice parsing, diagnostic reports
# Optional: Vercel AI Gateway provides VERCEL_OIDC_TOKEN automatically
PII_ENCRYPTION_KEY=replace-with-a-32-character-minimum-secret
AI_DIAGNOSTIC_MODEL=openai/gpt-5.4
AI_INVOICE_MODEL=openai/gpt-4o
# Enable only after a staging failover test. Deployment names are Azure aliases,
# not Gateway IDs such as openai/gpt-5.4. No non-Azure fallback after Gateway fails.
AZURE_AI_BACKUP_ENABLED=false
AZURE_RESOURCE_NAME=
AZURE_OPENAI_DEPLOYMENT=
# Optional per-task deployment overrides:
AZURE_PRE_DISPATCH_DEPLOYMENT=
AZURE_DIAGNOSTIC_DEPLOYMENT=
AZURE_INVOICE_DEPLOYMENT=
# Configure AZURE_API_KEY securely in the server deployment, never NEXT_PUBLIC_*.

# ============================================================================
# GGuard Pre-Dispatch (disabled by default)
# ============================================================================
PRE_DISPATCH_ENABLED=false
PRE_DISPATCH_ONBOARDING_ENABLED=false
PRE_DISPATCH_SUBMISSIONS_ENABLED=false
PRE_DISPATCH_WEBHOOKS_ENABLED=false
PRE_DISPATCH_AI_ANALYSIS_ENABLED=false
PRE_DISPATCH_EMAIL_ENABLED=false
PRE_DISPATCH_MAINTENANCE_RECORDS_ENABLED=false
PRE_DISPATCH_WORKER_ENABLED=false
PRE_DISPATCH_SIGNING_SECRET=replace-with-at-least-32-random-characters
PRE_DISPATCH_WORKER_SECRET=replace-with-at-least-32-random-characters
PRE_DISPATCH_AI_MODEL=openai/gpt-5.4
PRE_DISPATCH_MAX_PHOTO_BYTES=10485760
PRE_DISPATCH_MAX_VIDEO_BYTES=104857600
PRE_DISPATCH_MALWARE_SCANNER_URL=https://scanner.example.com/v1/scan-url
PRE_DISPATCH_MALWARE_SCANNER_SECRET=replace-with-a-long-random-scanner-secret

# Bot protection (configure after creating a Cloudflare Turnstile widget)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
